{
  "manifest_version": 3,
  "name": "NxTools Download Interceptor",
  "description": "Intercept browser downloads and send them to NxTools.",
  "version": "0.7.3",
  "minimum_chrome_version": "121",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "cookies",
    "declarativeNetRequest",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage",
    "activeTab",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "handoff-policy.js",
      "capture-policy.js",
      "blob-transfer-policy.js",
      "batch-handoff-policy.js",
      "bg/constants.js",
      "bg/state.js",
      "bg/naming.js",
      "bg/request-context.js",
      "bg/settings.js",
      "bg/native-transport.js",
      "bg/site-adapters.js",
      "bg/resource-cache.js",
      "bg/media.js",
      "bg/tab-bridge.js",
      "bg/capture.js",
      "bg/handoff.js",
      "bg/browser-handoff.js",
      "bg/resource-choices.js",
      "bg/link-collection.js",
      "bg/popup-state.js",
      "bg/context-menu.js",
      "bg/router.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shadow-styles.js", "blob-transfer-policy.js", "capture-policy.js", "content/constants.js", "content/runtime.js", "content/media-info.js", "content/media-inspection.js", "content/resource-choice-text.js", "content/blob-bridge.js", "content/media-geometry.js", "content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "NxTools",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; connect-src 'self' http: https:;"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nxtools-download-interceptor@nxtools.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
