<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>NxTools.PlatformHost</AssemblyName>
    <RootNamespace>NxTools.PlatformHost</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <Compile Remove="Generated\ReleaseBinaryManifest.g.cs" Condition="'$(ReleaseBinaryManifestPath)' != ''" />
    <Compile Include="$(ReleaseBinaryManifestPath)" Condition="'$(ReleaseBinaryManifestPath)' != ''" />
    <Compile Remove="Generated\ArchiveReleaseManifest.g.cs" Condition="'$(ArchiveReleaseManifestPath)' != ''" />
    <Compile Include="$(ArchiveReleaseManifestPath)" Condition="'$(ArchiveReleaseManifestPath)' != ''" />
    <Compile Remove="Generated\UpdateTrust.g.cs" Condition="'$(UpdateTrustPath)' != ''" />
    <Compile Include="$(UpdateTrustPath)" Condition="'$(UpdateTrustPath)' != ''" />
  </ItemGroup>
</Project>
