{
  "schema_version": 1,
  "id": "example.clipboard-text-tools",
  "name": "剪贴板文本工具",
  "version": "1.0.0",
  "description": "手动为所选文本去重行、格式化 JSON 或解码百分号；只创建派生条目，保留原文，不复制或粘贴。",
  "permissions": [
    {"id": "clipboard.read", "reason": "仅处理用户明确选中的文本快照；权限声明是信息，不是沙箱。"},
    {"id": "clipboard.write", "reason": "仅在结果有变化且非空时请求创建一次派生条目，保留原条目。"}
  ],
  "runtime": {"program": "python", "timeout_ms": 10000},
  "files": ["main.py", "protocol.py", "test_main.py", "README.md"],
  "settings": [],
  "handlers": [
    {"id": "unique-lines", "title": "按原顺序去重行（保留原文）", "feature": "clipboard", "entry": "action", "action": {"type": "script", "entry_file": "main.py"}},
    {"id": "pretty-json", "title": "格式化严格 JSON（保留原文）", "feature": "clipboard", "entry": "action", "action": {"type": "script", "entry_file": "main.py"}},
    {"id": "uri-decode", "title": "解码百分号文本（保留原文）", "feature": "clipboard", "entry": "action", "action": {"type": "script", "entry_file": "main.py"}}
  ]
}
