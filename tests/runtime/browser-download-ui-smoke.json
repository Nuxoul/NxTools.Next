{
  "name": "browser-download-visible-ui-acceptance",
  "steps": [
    {
      "action": "select_window",
      "selector": {
        "visible": true,
        "min_width": 480,
        "max_width": 540,
        "min_height": 250,
        "max_height": 340,
        "timeout_ms": 15000
      }
    },
    {
      "action": "capture",
      "name": "browser-download-probed"
    },
    {
      "action": "click",
      "x": 170,
      "y": 126
    },
    {
      "action": "key",
      "virtual_key": 35
    },
    {
      "action": "repeat_key",
      "virtual_key": 8,
      "count": 220
    },
    {
      "action": "type_text",
      "text_env": "NXTOOLS_UI_DOWNLOAD_DIRECTORY"
    },
    {
      "action": "click",
      "x": 180,
      "y": 181
    },
    {
      "action": "key",
      "virtual_key": 35
    },
    {
      "action": "repeat_key",
      "virtual_key": 8,
      "count": 100
    },
    {
      "action": "type_text",
      "text_env": "NXTOOLS_UI_DOWNLOAD_NAME"
    },
    {
      "action": "capture",
      "name": "browser-download-target-ready"
    },
    {
      "action": "click",
      "x": 388,
      "y": 250
    },
    {
      "action": "select_window",
      "selector": {
        "visible": true,
        "min_width": 420,
        "max_width": 480,
        "min_height": 160,
        "max_height": 220,
        "timeout_ms": 5000
      }
    },
    {
      "action": "capture",
      "name": "browser-download-progress"
    },
    {
      "action": "assert_file",
      "path_env": "NXTOOLS_UI_DOWNLOAD_PATH",
      "exact_bytes_env": "NXTOOLS_UI_EXPECTED_BYTES",
      "sha256_env": "NXTOOLS_UI_EXPECTED_SHA256",
      "timeout_ms": 60000
    }
  ]
}
